<!-- Signed-in home with shortcuts and recent recipes. -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><span class="eyebrow">YOUR KITCHEN</span><h1 class="h2">Welcome back, <%= currentUser.name %>!</h1><p class="text-muted mb-0">You have shared <%= count %> recipe<%= count===1?'':'s' %> so far.</p></div><a class="btn btn-primary" href="/recipes/new">＋ Share a recipe</a></div><div class="row g-3 mb-5"><div class="col-6 col-lg-3"><a class="shortcut" href="/ai/generator">✨ Generate a recipe</a></div><div class="col-6 col-lg-3"><a class="shortcut" href="/ai/assistant">💬 Ask a cooking question</a></div><div class="col-6 col-lg-3"><a class="shortcut" href="/favorites">♥ Your favorites</a></div><div class="col-6 col-lg-3"><a class="shortcut" href="/profile">◉ Your profile</a></div></div><h2 class="h4 mb-3">Recently added</h2><div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4"><% recipes.forEach(recipe=>{ %><%- include('partials/recipe-card',{recipe}) %><% }) %></div>
