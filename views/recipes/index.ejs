<!-- Searchable recipe collection and filters. -->
<div class="mb-4"><span class="eyebrow">DISCOVER</span><h1>Recipes for real life</h1><p class="text-muted">Search ingredients, dishes, or tags and find your next favorite.</p></div><form class="filter-panel row g-2 mb-4"><div class="col-lg-5"><input class="form-control" name="q" value="<%= filters.q||'' %>" placeholder="Search recipes or ingredients"></div><div class="col-6 col-lg-2"><select class="form-select" name="cuisine"><option value="">Any cuisine</option><% ['Italian','Indian','Mexican','Mediterranean','American','Other'].forEach(x=>{ %><option <%= filters.cuisine===x?'selected':'' %>><%= x %></option><% }) %></select></div><div class="col-6 col-lg-2"><select class="form-select" name="difficulty"><option value="">Any difficulty</option><% ['Easy','Medium','Hard'].forEach(x=>{ %><option <%= filters.difficulty===x?'selected':'' %>><%= x %></option><% }) %></select></div><div class="col-8 col-lg-2"><input class="form-control" type="number" min="1" name="maxTime" value="<%= filters.maxTime||'' %>" placeholder="Around how many minutes?"></div><div class="col-4 col-lg-1 d-grid"><button class="btn btn-primary">Find</button></div><small class="text-muted">Time and difficulty are flexible matches; closest matches appear first.</small></form><div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4"><% recipes.forEach(recipe=>{ %><%- include('../partials/recipe-card',{recipe}) %><% }) %></div><% if(!recipes.length){ %><div class="empty-state"><h2>No recipes found</h2><p>Try another search or clear the filters.</p><a href="/recipes" class="btn btn-outline-primary">Clear filters</a></div><% } %>

