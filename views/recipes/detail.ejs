<!-- Full recipe detail with history tracking and favorite action. -->
<a class="small text-muted" href="/recipes">← All recipes</a><div class="row g-4 mt-1"><div class="col-lg-6"><img class="detail-image" src="<%= recipe.image_path||'/images/food.svg' %>" alt="<%= recipe.title %>"></div><div class="col-lg-6"><span class="eyebrow"><%= recipe.cuisine %> · <%= recipe.difficulty %></span><h1 class="mt-2"><%= recipe.title %></h1><p class="text-muted">By <%= recipe.author_name||'Smart Recipe kitchen' %> · <%= recipe.cooking_time %> minutes</p><div class="d-flex flex-wrap gap-2 align-items-center"><button class="btn btn-outline-secondary" type="button" id="share-recipe" data-title="<%= recipe.title %>">↗ Share recipe</button><span id="share-status" class="small text-muted" aria-live="polite"></span><% if(currentUser){ %><form class="m-0" action="/recipes/<%= recipe.id %>/favorite" method="post"><button class="btn <%= fav?'btn-primary':'btn-outline-primary' %>"><%= fav?'♥ Saved to favorites':'♡ Save to favorites' %></button></form><% } %></div></div></div><div class="row g-5 mt-2"><section class="col-md-5"><h2 class="h4">Ingredients</h2><ul class="ingredient-list"><% recipe.ingredients.split(/\r?\n/).filter(Boolean).forEach(x=>{ %><li><%= x %></li><% }) %></ul></section><section class="col-md-7"><h2 class="h4">How to make it</h2><ol class="steps-list"><% recipe.steps.split(/\r?\n/).filter(Boolean).forEach(x=>{ %><li><%= x.replace(/^\d+[.)]\s*/, '') %></li><% }) %></ol></section></div>
