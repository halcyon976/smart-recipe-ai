<!-- Recipe creation and editing form with an actual image file input. -->
<div class="mb-4"><span class="eyebrow">YOUR RECIPE</span><h1><%= recipe?'Edit recipe':'Share a recipe' %></h1><p class="text-muted">Write it down so someone else can make it, too.</p></div><form action="<%= recipe?`/recipes/${recipe.id}/edit`:'/recipes' %>" method="post" enctype="multipart/form-data" class="form-panel"><div class="mb-3"><label class="form-label">Recipe title</label><input class="form-control" name="title" required maxlength="180" value="<%= recipe?.title||'' %>"></div><div class="row"><div class="col-md-4 mb-3"><label class="form-label">Cooking time (minutes)</label><input class="form-control" type="number" name="cooking_time" min="1" required value="<%= recipe?.cooking_time||30 %>"></div><div class="col-md-4 mb-3"><label class="form-label">Difficulty</label><select class="form-select" name="difficulty"><% ['Easy','Medium','Hard'].forEach(x=>{ %><option <%= recipe?.difficulty===x?'selected':'' %>><%= x %></option><% }) %></select></div><div class="col-md-4 mb-3"><label class="form-label">Cuisine</label><input class="form-control" name="cuisine" maxlength="80" value="<%= recipe?.cuisine||'' %>" placeholder="e.g. Indian"></div></div><div class="mb-3"><label class="form-label">Ingredients <span class="text-muted">(one per line)</span></label><textarea class="form-control" name="ingredients" rows="5" required><%= recipe?.ingredients||'' %></textarea></div><div class="mb-3"><label class="form-label">Steps <span class="text-muted">(one per line)</span></label><textarea class="form-control" name="steps" rows="6" required><%= recipe?.steps||'' %></textarea></div><div class="mb-3"><label class="form-label">Tags <span class="text-muted">(comma separated)</span></label><input class="form-control" name="tags" value="<%= recipe?.tags?.join(', ')||'' %>" placeholder="quick, vegetarian"></div><div class="mb-4"><label class="form-label">Recipe photo</label><input type="file" class="form-control" name="image" accept="image/png,image/jpeg,image/webp,image/gif"><div class="form-text">Optional. JPG, PNG, WebP, or GIF; up to 5 MB.</div></div><button class="btn btn-primary btn-lg"><%= recipe?'Save changes':'Publish recipe' %></button><a class="btn btn-link" href="/my-recipes">Cancel</a></form>
