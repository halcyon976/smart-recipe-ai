<!-- User's recipe collection with edit and delete controls. -->
<div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">YOUR CONTRIBUTIONS</span><h1>My recipes</h1></div><a class="btn btn-primary" href="/recipes/new">＋ New recipe</a></div><% if(recipes.length){ %><div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4"><% recipes.forEach(recipe=>{ %><div class="col"><%- include('../partials/recipe-card',{recipe}) %><div class="d-flex gap-2 mt-2"><a class="btn btn-sm btn-outline-secondary" href="/recipes/<%= recipe.id %>/edit">Edit</a><form action="/recipes/<%= recipe.id %>/delete" method="post" data-confirm="Delete this recipe? This cannot be undone."><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div><% }) %></div><% }else{ %><div class="empty-state"><div class="empty-icon">🍲</div><h2>Your recipe box is waiting</h2><p>Share the first recipe from your kitchen.</p><a href="/recipes/new" class="btn btn-primary">Add a recipe</a></div><% } %>
