<!-- Profile editor and recently viewed recipes. -->
<span class="eyebrow">ACCOUNT</span><h1>Your profile</h1><div class="row g-5 mt-1"><div class="col-lg-5"><form class="form-panel" method="post" action="/profile"><div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" maxlength="100" required value="<%= profile.name %>"></div><div class="mb-3"><label class="form-label">Email</label><input class="form-control" value="<%= profile.email %>" disabled></div><div class="mb-3"><label class="form-label">A little about you</label><textarea class="form-control" name="bio" rows="4" maxlength="500"><%= profile.bio||'' %></textarea></div><button class="btn btn-primary">Save profile</button></form><form class="form-panel mt-3" method="post" action="/profile/password"><h2 class="h5">Change password</h2><div class="mb-3"><label class="form-label">Current password</label><input class="form-control" type="password" name="current_password" required autocomplete="current-password"></div><div class="mb-3"><label class="form-label">New password (8 characters minimum)</label><input class="form-control" type="password" name="new_password" minlength="8" maxlength="128" required autocomplete="new-password"></div><div class="mb-3"><label class="form-label">Confirm new password</label><input class="form-control" type="password" name="confirm_password" minlength="8" maxlength="128" required autocomplete="new-password"></div><button class="btn btn-primary">Change password</button></form></div><div class="col-lg-7"><h2 class="h4 mb-3">Recently viewed</h2><% if(history.length){ %><div class="row row-cols-1 row-cols-sm-2 g-3"><% history.forEach(recipe=>{ %><%- include('partials/recipe-card',{recipe}) %><% }) %></div><% }else{ %><p class="text-muted">Recipes you open will appear here.</p><% } %></div></div>


