<!-- Landing page with a clear introduction and featured recipes. -->
<section class="hero rounded-4 p-4 p-lg-5 mb-5"><div class="row align-items-center g-4"><div class="col-lg-7"><span class="eyebrow">GOOD FOOD, LESS GUESSWORK</span><h1 class="display-4 fw-bold mt-3">Make something <span class="text-primary">delicious.</span></h1><p class="lead text-secondary">Find recipes for what you have, save your favorites, and get a little help from your AI cooking companion.</p><a class="btn btn-primary btn-lg me-2" href="/recipes">Explore recipes</a><% if(!currentUser){ %><a class="btn btn-outline-dark btn-lg" href="/signup">Join for free</a><% } else { %><a class="btn btn-outline-dark btn-lg" href="/ai/generator">Create with AI</a><% } %></div><div class="col-lg-5 text-center"><img src="/images/food.svg" class="hero-image" alt="Illustration of a colorful meal"></div></div></section><div class="d-flex justify-content-between align-items-end mb-3"><div><span class="eyebrow">FROM THE COMMUNITY</span><h2 class="h3 mb-0">Fresh ideas for your table</h2></div><a href="/recipes">See all recipes →</a></div><div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4"><% recipes.forEach(recipe=>{ %><%- include('partials/recipe-card',{recipe}) %><% }) %></div>
