<!-- Reusable recipe preview card. -->
<div class="col"><article class="card recipe-card h-100"><a href="/recipes/<%= recipe.id %>" class="image-link"><img class="card-img-top recipe-image" src="<%= recipe.image_path || '/images/food.svg' %>" alt="<%= recipe.title %>"></a><div class="card-body d-flex flex-column"><div class="d-flex justify-content-between small text-muted mb-2"><span><%= recipe.cuisine %></span><span><%= recipe.cooking_time %> min</span></div><h3 class="h5"><a class="text-decoration-none text-dark" href="/recipes/<%= recipe.id %>"><%= recipe.title %></a><% if((typeof showFavorite !== 'undefined' && showFavorite) || recipe.is_favorite){ %> <span class="favorite-heart" role="img" aria-label="Favorited">♥</span><% } %></h3><p class="text-muted small mb-3"><%= recipe.author_name || 'Smart Recipe kitchen' %></p><div class="mt-auto"><a class="btn btn-sm btn-outline-primary" href="/recipes/<%= recipe.id %>">View recipe</a></div></div></article></div>
