<!-- Existing user login form. -->
<div class="auth-card"><span class="eyebrow">GOOD TO SEE YOU</span><h1 class="h2 mt-2">Log in</h1><p class="text-muted">Pick up where you left off.</p><form action="/login" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required autocomplete="email"></div><div class="mb-2"><label class="form-label">Password</label><input name="password" type="password" class="form-control" required autocomplete="current-password"></div><p class="text-end mb-3"><a href="/forgot-password">Forgot password?</a></p><button class="btn btn-primary w-100 btn-lg">Log in</button></form><p class="mt-3 text-center">New here? <a href="/signup">Create an account</a></p></div>
