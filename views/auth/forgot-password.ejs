<!-- Request a one-time password reset link. -->
<div class="auth-card"><span class="eyebrow">ACCOUNT RECOVERY</span><h1 class="h2 mt-2">Forgot password?</h1><p class="text-muted">Enter your account email. If it matches, we’ll send a reset link.</p><form action="/forgot-password" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-4"><label class="form-label">Email</label><input class="form-control" type="email" name="email" required autocomplete="email"></div><button class="btn btn-primary w-100">Send reset link</button></form><p class="mt-3 text-center"><a href="/login">Back to log in</a></p></div>
