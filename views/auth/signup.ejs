<!-- New account form. -->
<div class="auth-card"><span class="eyebrow">WELCOME TO THE TABLE</span><h1 class="h2 mt-2">Create your account</h1><p class="text-muted">Save recipes and make your own collection. You must verify your email before logging in.</p><form action="/signup" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">Name</label><input name="name" class="form-control" required maxlength="100" autocomplete="name"></div><div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required autocomplete="email"></div><div class="mb-4"><label class="form-label">Password</label><input name="password" type="password" class="form-control" minlength="8" required autocomplete="new-password"><div class="form-text">Use at least 8 characters.</div></div><button class="btn btn-primary w-100 btn-lg">Create account</button></form><p class="mt-3 text-center">Already have an account? <a href="/login">Log in</a></p></div>

