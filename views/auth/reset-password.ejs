<!-- Choose a new password using the emailed one-time token. -->
<div class="auth-card"><span class="eyebrow">ACCOUNT RECOVERY</span><h1 class="h2 mt-2">Choose a new password</h1><form action="/reset-password/<%= token %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">New password (8 characters minimum)</label><input class="form-control" type="password" name="password" minlength="8" maxlength="128" required autocomplete="new-password"></div><div class="mb-4"><label class="form-label">Confirm new password</label><input class="form-control" type="password" name="confirm_password" minlength="8" maxlength="128" required autocomplete="new-password"></div><button class="btn btn-primary w-100">Reset password</button></form></div>

