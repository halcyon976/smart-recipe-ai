<!-- Ingredient-to-recipe interface powered by the server endpoint. -->
<span class="eyebrow">A LITTLE KITCHEN MAGIC</span><h1>AI recipe generator</h1><p class="text-muted">Enter ingredients you have, or describe the dish you want to make. We’ll give you a known recipe or tell you what one or two ingredients are missing.</p><div class="form-panel"><label class="form-label" for="ingredients">Ingredients or recipe you want</label><textarea class="form-control" id="ingredients" rows="3" placeholder="e.g. chickpeas, spinach, tomato, rice — or “I want Alfredo pasta”"></textarea><button id="generate" class="btn btn-primary mt-3">✨ Find a recipe</button><div id="recipe-result" class="mt-4" aria-live="polite"></div></div><script src="/js/ai.js"></script>
